# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this
FLASK_ENV=production

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_public_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create on Stripe dashboard)
STRIPE_STARTER_PRICE_ID=price_your_starter_id_here
STRIPE_PRO_PRICE_ID=price_your_pro_id_here

# Hugging Face Token (get from https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=hf_your_token_here
